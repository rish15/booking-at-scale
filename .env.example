# Copy to .env for local development (docker-compose reads this too)

NODE_ENV=local
PORT=2000

# Local dev points at the PgBouncer container (see docker-compose.yml).
# In production (Render), this is set in the dashboard to Neon's POOLED
# connection string — never commit a real value here.
DATABASE_URL=postgres://seatapp:seatapp@localhost:6432/seats

# Used to verify the stateless bearer token in the auth middleware.
# Generate one with: npm run token -- <userId>
AUTH_TOKEN_SECRET=dev-secret-change-me

# Simple static key for the admin-only POST /shows endpoint.
# Sent as the "x-admin-key" header. Not a full admin auth system —
# a deliberate simplification for this exercise's scope.
ADMIN_KEY=dev-admin-key-change-me

# Business config
PER_USER_LIMIT=4
HOLD_EXPIRY_SECONDS=60

# Postgres session-level guards (see ARCHITECTURE.md "connection capacity" section)
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
DB_POOL_MAX=15
