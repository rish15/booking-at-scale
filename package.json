{
  "name": "paytm-seat-reservation",
  "version": "1.0.0",
  "description": "Seat Reservation at Scale — take-home exercise",
  "main": "dist/src/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/db && cp src/db/schema.sql dist/src/db/schema.sql",
    "start": "node dist/src/app.js",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/app.ts\"",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:migrate:build": "node dist/src/db/migrate.js",
    "token": "ts-node scripts/make-token.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "burst": "ts-node scripts/burst.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rish15/paytm-seat-reservation.git"
  },
  "keywords": [
    "fastify",
    "typescript",
    "postgres",
    "seat-reservation"
  ],
  "author": "rish15",
  "license": "ISC"
}
